{
  "compilerOptions": {
    "target": "es2020",
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "lib": ["es2020"],
    "types": ["@figma/plugin-typings"]
  },
  "include": ["src/**/*.ts"]
}
